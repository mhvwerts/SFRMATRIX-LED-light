# Normalize line endings: text files are stored with LF in the repository
* text=auto

# Windows batch files must keep CRLF on checkout
*.bat text eol=crlf

# Binary files: never touch line endings, never diff as text
*.png  binary
*.jpg  binary
*.pdf  binary
*.stl  binary
*.ipt  binary

# Keep these out of GitHub's language statistics
*.js    linguist-detectable=false
*.html  linguist-detectable=false
*.htm   linguist-detectable=false
*.css   linguist-detectable=false
*.ipynb linguist-detectable=false

